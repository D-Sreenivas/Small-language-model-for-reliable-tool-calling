# Small Language Model for Reliable Tool Calling Configuration

# App & Server Settings
APP_ENV=development
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
FRONTEND_PORT=8501
API_BASE_URL=http://127.0.0.1:8000

# Model Settings: gemini, huggingface, llama_cpp, vllm, mock
MODEL_BACKEND=gemini
BASE_MODEL_NAME=gemini-3.8-flash

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

DEVICE=auto
LOAD_IN_4BIT=true
MAX_SEQ_LENGTH=2048
TEMPERATURE=0.1
TOP_P=0.9
MAX_NEW_TOKENS=512

# Storage & Cache Paths
DATASET_DIR=./datasets
MODELS_DIR=./models
PICKLE_STORE_DIR=./pickle_store
TOOL_SCHEMAS_DIR=./tool_schemas

# Security & Constraints
ENFORCE_SCHEMA_CONSTRAINTS=true
MAX_EXECUTION_TIMEOUT_SECONDS=10
ALLOWED_TOOLS=["calculator", "unit_converter", "database_lookup", "mock_search"]

WEATHER_API_KEY=mock_key
SEARCH_API_KEY=mock_key
DATABASE_URL=sqlite:///./lookup.db
